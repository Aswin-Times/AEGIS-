# Runtime connection: must use the restricted aegis_app role. The API refuses to start otherwise.
AEGIS_ENVIRONMENT=development
AEGIS_DATABASE_URL=postgresql+psycopg://aegis_app:CHANGE_ME@127.0.0.1:5432/aegis
# Path to an Ed25519 private key in PEM format. Keep it out of the repository.
AEGIS_JWT_PRIVATE_KEY_PATH=/path/to/jwt-ed25519.pem
